rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    match /staff/{staffId} {
      allow read: if true; // Public staff directory
      allow create, update, delete: if isValidId(staffId);
    }

    match /admins/{adminId} {
      allow read: if true;
      allow write: if true;
    }

    match /settings/{settingId} {
      allow read: if true;
      allow write: if isValidId(settingId);
    }

    match /test/{docId} {
      allow read, write: if true;
    }
  }
}
